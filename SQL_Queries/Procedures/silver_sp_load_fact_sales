-- =====================================================
-- silver.sp_load_fact_sales  (standalone: helper functions + one procedure)
-- Prerequisites (load these first): dim_geography, dim_product, dim_person,
--                                   dim_sales_territory, dim_shipper
-- Run:    CALL silver.sp_load_fact_sales(1);
-- =====================================================

CREATE OR REPLACE FUNCTION silver.f_clean(x text) RETURNS text
LANGUAGE sql IMMUTABLE AS $$ SELECT NULLIF(TRIM(x), '') $$;

CREATE OR REPLACE FUNCTION silver.f_geo(x text) RETURNS text
LANGUAGE sql IMMUTABLE AS $$ SELECT COALESCE(NULLIF(TRIM(x), ''), 'N/A') $$;

-- =====================================================
-- fact_sales: AW22 + NW1 + CNK1 order lines
-- =====================================================
CREATE OR REPLACE PROCEDURE silver.sp_load_fact_sales(p_batch_id BIGINT)
LANGUAGE plpgsql AS $$
BEGIN
    MERGE INTO silver.fact_sales t
    USING (
        WITH
        aw_hdr  AS (SELECT DISTINCT ON (salesorderid) * FROM bronze.aw22_salesorderheader ORDER BY salesorderid, load_date DESC),
        aw_det  AS (SELECT DISTINCT ON (salesorderid, salesorderdetailid) * FROM bronze.aw22_salesorderdetail
                    ORDER BY salesorderid, salesorderdetailid, load_date DESC),
        aw_adr  AS (SELECT DISTINCT ON (addressid)         * FROM bronze.aw22_address       ORDER BY addressid, load_date DESC),
        aw_sp   AS (SELECT DISTINCT ON (stateprovinceid)   * FROM bronze.aw22_stateprovince ORDER BY stateprovinceid, load_date DESC),
        aw_cr   AS (SELECT DISTINCT ON (countryregioncode) * FROM bronze.aw22_countryregion ORDER BY countryregioncode, load_date DESC),
        nw_hdr  AS (SELECT DISTINCT ON (orderid) * FROM bronze.nw1_orders ORDER BY orderid, load_date DESC),
        nw_det  AS (SELECT DISTINCT ON (orderid, productid) * FROM bronze.nw1_order_details ORDER BY orderid, productid, load_date DESC),
        ck_inv  AS (SELECT DISTINCT ON (invoiceid)     * FROM bronze.cnk1_invoice     ORDER BY invoiceid,     load_date DESC),
        ck_line AS (SELECT DISTINCT ON (invoicelineid) * FROM bronze.cnk1_invoiceline ORDER BY invoicelineid, load_date DESC),
        ck_cus  AS (SELECT DISTINCT ON (customerid)    * FROM bronze.cnk1_customer    ORDER BY customerid,    load_date DESC),

        lines (src_sys_id, src_order_id, src_line_id, prod_id, cust_id, emp_id, geo_id, terr_id, shipper_id,
               order_date, due_date, ship_date, quantity, unit_price, discount, line_total, hdr_freight, hdr_tax) AS (
            -- AW22
            SELECT 'AW22', d.salesorderid::text, d.salesorderdetailid::text, d.productid::text,
                   h.customerid::text, h.salespersonid::text,
                   silver.f_geo(cr.name) || '|' || silver.f_geo(sp.name) || '|' || silver.f_geo(a.city),
                   h.territoryid::text, NULL::text,
                   h.orderdate::date, h.duedate::date, h.shipdate::date,
                   d.orderqty::numeric, d.unitprice::numeric, d.unitpricediscount::numeric,
                   d.orderqty * d.unitprice * (1 - d.unitpricediscount),
                   h.freight::numeric, h.taxamt::numeric
            FROM aw_det d
            JOIN aw_hdr h ON h.salesorderid = d.salesorderid
            LEFT JOIN aw_adr a ON a.addressid = h.shiptoaddressid
            LEFT JOIN aw_sp sp ON sp.stateprovinceid = a.stateprovinceid
            LEFT JOIN aw_cr cr ON cr.countryregioncode = sp.countryregioncode
            UNION ALL
            -- NW1 (order line id = productid: [Order Details] has no own ID)
            SELECT 'NW1', d.orderid::text, d.productid::text, d.productid::text,
                   silver.f_clean(h.customerid), h.employeeid::text,
                   silver.f_geo(h.shipcountry) || '|' || silver.f_geo(h.shipregion) || '|' || silver.f_geo(h.shipcity),
                   NULL::text, h.shipvia::text,
                   h.orderdate::date, h.requireddate::date, h.shippeddate::date,
                   d.quantity::numeric, d.unitprice::numeric, d.discount::numeric(9,4),
                   d.quantity * d.unitprice * (1 - d.discount::numeric(9,4)),
                   h.freight::numeric, NULL::numeric
            FROM nw_det d
            JOIN nw_hdr h ON h.orderid = d.orderid
            UNION ALL
            -- CNK1 (employee = customer's support rep)
            SELECT 'CNK1', l.invoiceid::text, l.invoicelineid::text, l.trackid::text,
                   i.customerid::text, c.supportrepid::text,
                   silver.f_geo(i.billingcountry) || '|' || silver.f_geo(i.billingstate) || '|' || silver.f_geo(i.billingcity),
                   NULL::text, NULL::text,
                   i.invoicedate::date, NULL::date, NULL::date,
                   l.quantity::numeric, l.unitprice::numeric, 0::numeric,
                   l.quantity * l.unitprice,
                   NULL::numeric, NULL::numeric
            FROM ck_line l
            JOIN ck_inv i ON i.invoiceid = l.invoiceid
            LEFT JOIN ck_cus c ON c.customerid = i.customerid
        ),
        alloc AS (
            SELECT l.*, SUM(l.line_total) OVER (PARTITION BY l.src_sys_id, l.src_order_id) AS order_total
            FROM lines l
        )
        SELECT a.src_sys_id, a.src_order_id, a.src_line_id,
               COALESCE(dp.product_key, -1)  AS product_key,
               COALESCE(dc.person_key, -1)   AS customer_key,
               COALESCE(de.person_key, -1)   AS employee_key,
               COALESCE(dg.geography_key, -1) AS ship_geography_key,
               COALESCE(dt.territory_key, -1) AS territory_key,
               COALESCE(ds.shipper_key, -1)  AS shipper_key,
               a.order_date, a.due_date, a.ship_date,
               a.quantity::numeric(18,4)   AS quantity,
               a.unit_price::numeric(19,4) AS unit_price,
               a.discount::numeric(9,4)    AS discount,
               a.line_total::numeric(19,4) AS line_total,
               ROUND(a.hdr_freight * a.line_total / NULLIF(a.order_total, 0), 4) AS allocated_freight,
               ROUND(a.hdr_tax     * a.line_total / NULLIF(a.order_total, 0), 4) AS allocated_tax
        FROM alloc a
        LEFT JOIN silver.dim_product dp ON dp.src_sys_id = a.src_sys_id AND dp.src_product_id = a.prod_id AND dp.is_current
        LEFT JOIN silver.dim_person  dc ON dc.src_sys_id = a.src_sys_id AND dc.person_type = 'CUSTOMER'
                                       AND dc.src_person_id = a.cust_id AND dc.is_current
        LEFT JOIN silver.dim_person  de ON de.src_sys_id = a.src_sys_id AND de.person_type = 'EMPLOYEE'
                                       AND de.src_person_id = a.emp_id AND de.is_current
        LEFT JOIN silver.dim_geography dg ON dg.src_sys_id = a.src_sys_id AND dg.src_geo_id = a.geo_id
        LEFT JOIN silver.dim_sales_territory dt ON dt.src_sys_id = a.src_sys_id AND dt.src_territory_id = a.terr_id
        LEFT JOIN silver.dim_shipper ds ON ds.src_sys_id = a.src_sys_id AND ds.src_shipper_id = a.shipper_id
    ) s
       ON t.src_sys_id = s.src_sys_id AND t.src_order_id = s.src_order_id AND t.src_line_id = s.src_line_id
    -- SCD2 keys (product, customer, employee) are NOT re-pointed to a newer dimension version:
    -- the fact keeps the version that was current when the row was first loaded.
    -- Only a late-arriving dimension (key = -1) gets fixed later.
    WHEN MATCHED AND (
         ROW(t.ship_geography_key, t.territory_key, t.shipper_key, t.order_date, t.due_date, t.ship_date,
             t.quantity, t.unit_price, t.discount, t.line_total, t.allocated_freight, t.allocated_tax)
         IS DISTINCT FROM
         ROW(s.ship_geography_key, s.territory_key, s.shipper_key, s.order_date, s.due_date, s.ship_date,
             s.quantity, s.unit_price, s.discount, s.line_total, s.allocated_freight, s.allocated_tax)
         OR (t.product_key  = -1 AND s.product_key  <> -1)
         OR (t.customer_key = -1 AND s.customer_key <> -1)
         OR (t.employee_key = -1 AND s.employee_key <> -1)
    ) THEN
         UPDATE SET product_key  = CASE WHEN t.product_key  = -1 THEN s.product_key  ELSE t.product_key  END,
                    customer_key = CASE WHEN t.customer_key = -1 THEN s.customer_key ELSE t.customer_key END,
                    employee_key = CASE WHEN t.employee_key = -1 THEN s.employee_key ELSE t.employee_key END,
                    ship_geography_key = s.ship_geography_key, territory_key = s.territory_key,
                    shipper_key = s.shipper_key, order_date = s.order_date, due_date = s.due_date,
                    ship_date = s.ship_date, quantity = s.quantity, unit_price = s.unit_price,
                    discount = s.discount, line_total = s.line_total,
                    allocated_freight = s.allocated_freight, allocated_tax = s.allocated_tax,
                    load_dts = CURRENT_TIMESTAMP, batch_id = p_batch_id
    WHEN NOT MATCHED THEN
         INSERT (src_sys_id, src_order_id, src_line_id, product_key, customer_key, employee_key,
                 ship_geography_key, territory_key, shipper_key, order_date, due_date, ship_date,
                 quantity, unit_price, discount, line_total, allocated_freight, allocated_tax, batch_id)
         VALUES (s.src_sys_id, s.src_order_id, s.src_line_id, s.product_key, s.customer_key, s.employee_key,
                 s.ship_geography_key, s.territory_key, s.shipper_key, s.order_date, s.due_date, s.ship_date,
                 s.quantity, s.unit_price, s.discount, s.line_total, s.allocated_freight, s.allocated_tax, p_batch_id);
END $$;