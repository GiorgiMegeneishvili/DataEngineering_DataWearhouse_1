-- =====================================================
-- silver.sp_load_dim_person  (standalone: helper functions + one procedure)
-- Prerequisites: silver.dim_geography exists and is already loaded
--                (CALL silver.sp_load_dim_geography(...) first)
-- Run:    CALL silver.sp_load_dim_person(1);
-- =====================================================

-- ---------- helper functions ----------
CREATE OR REPLACE FUNCTION silver.f_clean(x text) RETURNS text
LANGUAGE sql IMMUTABLE AS $$ SELECT NULLIF(TRIM(x), '') $$;

CREATE OR REPLACE FUNCTION silver.f_geo(x text) RETURNS text
LANGUAGE sql IMMUTABLE AS $$ SELECT COALESCE(NULLIF(TRIM(x), ''), 'N/A') $$;



-- =====================================================
-- dim_person (SCD2): customers + employees, all 3 sources
-- =====================================================
CREATE OR REPLACE PROCEDURE silver.sp_load_dim_person(p_batch_id BIGINT)
LANGUAGE plpgsql AS $$
BEGIN
    DROP TABLE IF EXISTS tmp_dim_person;

    CREATE TEMP TABLE tmp_dim_person ON COMMIT DROP AS
    WITH
    aw_cus  AS (SELECT DISTINCT ON (customerid)       * FROM bronze.aw22_customer  ORDER BY customerid,       load_date DESC),
    aw_per  AS (SELECT DISTINCT ON (businessentityid) * FROM bronze.aw22_person    ORDER BY businessentityid, load_date DESC),
    aw_sto  AS (SELECT DISTINCT ON (businessentityid) * FROM bronze.aw22_store     ORDER BY businessentityid, load_date DESC),
    aw_emp  AS (SELECT DISTINCT ON (businessentityid) * FROM bronze.aw22_employee  ORDER BY businessentityid, load_date DESC),
    aw_bea  AS (SELECT DISTINCT ON (businessentityid, addressid, addresstypeid) * FROM bronze.aw22_businessentityaddress
                ORDER BY businessentityid, addressid, addresstypeid, load_date DESC),
    aw_adr  AS (SELECT DISTINCT ON (addressid)         * FROM bronze.aw22_address       ORDER BY addressid, load_date DESC),
    aw_sp   AS (SELECT DISTINCT ON (stateprovinceid)   * FROM bronze.aw22_stateprovince ORDER BY stateprovinceid, load_date DESC),
    aw_cr   AS (SELECT DISTINCT ON (countryregioncode) * FROM bronze.aw22_countryregion ORDER BY countryregioncode, load_date DESC),
    nw_cus  AS (SELECT DISTINCT ON (customerid) * FROM bronze.nw1_customers ORDER BY customerid, load_date DESC),
    nw_emp  AS (SELECT DISTINCT ON (employeeid) * FROM bronze.nw1_employees ORDER BY employeeid, load_date DESC),
    ck_cus  AS (SELECT DISTINCT ON (customerid) * FROM bronze.cnk1_customer ORDER BY customerid, load_date DESC),
    ck_emp  AS (SELECT DISTINCT ON (employeeid) * FROM bronze.cnk1_employee ORDER BY employeeid, load_date DESC),

    -- one AW22 address per entity: Main Office(3) > Home(2) > Billing(1) > other
    aw_addr AS (
        SELECT DISTINCT ON (b.businessentityid)
               b.businessentityid, a.addressline1, a.addressline2, a.city, a.postalcode,
               sp.name AS state_name, cr.name AS country_name
        FROM aw_bea b
        JOIN aw_adr a ON a.addressid = b.addressid
        LEFT JOIN aw_sp sp ON sp.stateprovinceid = a.stateprovinceid
        LEFT JOIN aw_cr cr ON cr.countryregioncode = sp.countryregioncode
        ORDER BY b.businessentityid,
                 CASE b.addresstypeid WHEN 3 THEN 1 WHEN 2 THEN 2 WHEN 1 THEN 3 ELSE 4 END, b.addressid
    ),

    -- column order is the same in every branch
    raw (src_sys_id, person_type, src_person_id, customer_kind, first_name, last_name, full_name,
         company_name, job_title, birth_date, hire_date, gender, marital_status, email, phone, fax,
         address_line, postal_code, country, state_province, city,
         manager_src_id, territory_src_id, support_rep_src_id) AS (

        -- AW22 customers (INDIVIDUAL = Person, COMPANY = Store)
        SELECT 'AW22', 'CUSTOMER', c.customerid::text,
               CASE WHEN c.storeid IS NOT NULL THEN 'COMPANY' ELSE 'INDIVIDUAL' END,
               silver.f_clean(p.firstname), silver.f_clean(p.lastname),
               COALESCE(silver.f_clean(concat_ws(' ', p.firstname, p.lastname)), silver.f_clean(s.name)),
               silver.f_clean(s.name), NULL, NULL::date, NULL::date, NULL, NULL, NULL, NULL, NULL,
               silver.f_clean(concat_ws(', ', ad.addressline1, ad.addressline2)), silver.f_clean(ad.postalcode),
               silver.f_geo(ad.country_name), silver.f_geo(ad.state_name), silver.f_geo(ad.city),
               NULL, c.territoryid::text, NULL
        FROM aw_cus c
        LEFT JOIN aw_per p  ON p.businessentityid  = c.personid
        LEFT JOIN aw_sto s  ON s.businessentityid  = c.storeid
        LEFT JOIN aw_addr ad ON ad.businessentityid = COALESCE(c.storeid, c.personid)

        UNION ALL
        -- AW22 employees
        SELECT 'AW22', 'EMPLOYEE', e.businessentityid::text, NULL,
               silver.f_clean(p.firstname), silver.f_clean(p.lastname),
               silver.f_clean(concat_ws(' ', p.firstname, p.lastname)), NULL, silver.f_clean(e.jobtitle),
               e.birthdate::date, e.hiredate::date, silver.f_clean(e.gender), silver.f_clean(e.maritalstatus),
               NULL, NULL, NULL,
               silver.f_clean(concat_ws(', ', ad.addressline1, ad.addressline2)), silver.f_clean(ad.postalcode),
               silver.f_geo(ad.country_name), silver.f_geo(ad.state_name), silver.f_geo(ad.city),
               NULL, NULL, NULL
        FROM aw_emp e
        LEFT JOIN aw_per p   ON p.businessentityid  = e.businessentityid
        LEFT JOIN aw_addr ad ON ad.businessentityid = e.businessentityid

        UNION ALL
        -- NW1 customers
        SELECT 'NW1', 'CUSTOMER', silver.f_clean(x.customerid), NULL,
               NULL, NULL, silver.f_clean(x.contactname), silver.f_clean(x.companyname), silver.f_clean(x.contacttitle),
               NULL::date, NULL::date, NULL, NULL, NULL, silver.f_clean(x.phone), silver.f_clean(x.fax),
               silver.f_clean(x.address), silver.f_clean(x.postalcode),
               silver.f_geo(x.country), silver.f_geo(x.region), silver.f_geo(x.city),
               NULL, NULL, NULL
        FROM nw_cus x

        UNION ALL
        -- NW1 employees
        SELECT 'NW1', 'EMPLOYEE', x.employeeid::text, NULL,
               silver.f_clean(x.firstname), silver.f_clean(x.lastname),
               silver.f_clean(concat_ws(' ', x.firstname, x.lastname)), NULL, silver.f_clean(x.title),
               x.birthdate::date, x.hiredate::date, NULL, NULL, NULL, silver.f_clean(x.homephone), NULL,
               silver.f_clean(x.address), silver.f_clean(x.postalcode),
               silver.f_geo(x.country), silver.f_geo(x.region), silver.f_geo(x.city),
               x.reportsto::text, NULL, NULL
        FROM nw_emp x

        UNION ALL
        -- CNK1 customers
        SELECT 'CNK1', 'CUSTOMER', x.customerid::text, NULL,
               silver.f_clean(x.firstname), silver.f_clean(x.lastname),
               silver.f_clean(concat_ws(' ', x.firstname, x.lastname)), silver.f_clean(x.company), NULL,
               NULL::date, NULL::date, NULL, NULL, silver.f_clean(x.email), silver.f_clean(x.phone), silver.f_clean(x.fax),
               silver.f_clean(x.address), silver.f_clean(x.postalcode),
               silver.f_geo(x.country), silver.f_geo(x.state), silver.f_geo(x.city),
               NULL, NULL, x.supportrepid::text
        FROM ck_cus x

        UNION ALL
        -- CNK1 employees
        SELECT 'CNK1', 'EMPLOYEE', x.employeeid::text, NULL,
               silver.f_clean(x.firstname), silver.f_clean(x.lastname),
               silver.f_clean(concat_ws(' ', x.firstname, x.lastname)), NULL, silver.f_clean(x.title),
               x.birthdate::date, x.hiredate::date, NULL, NULL, silver.f_clean(x.email), silver.f_clean(x.phone), silver.f_clean(x.fax),
               silver.f_clean(x.address), silver.f_clean(x.postalcode),
               silver.f_geo(x.country), silver.f_geo(x.state), silver.f_geo(x.city),
               x.reportsto::text, NULL, NULL
        FROM ck_emp x
    ),
    withgeo AS (
        SELECT r.src_sys_id, r.person_type, r.src_person_id, r.customer_kind, r.first_name, r.last_name,
               r.full_name, r.company_name, r.job_title, r.birth_date, r.hire_date, r.gender, r.marital_status,
               r.email, r.phone, r.fax, r.address_line, r.postal_code,
               COALESCE(g.geography_key, -1) AS geography_key,
               r.manager_src_id, r.territory_src_id, r.support_rep_src_id
        FROM raw r
        LEFT JOIN silver.dim_geography g
               ON g.src_sys_id = r.src_sys_id
              AND g.src_geo_id = r.country || '|' || r.state_province || '|' || r.city
    )
    SELECT w.*,
           md5(ROW(w.customer_kind, w.first_name, w.last_name, w.full_name, w.company_name, w.job_title,
                   w.birth_date, w.hire_date, w.gender, w.marital_status, w.email, w.phone, w.fax,
                   w.address_line, w.postal_code, w.geography_key,
                   w.manager_src_id, w.territory_src_id, w.support_rep_src_id)::text) AS row_hash
    FROM withgeo w;

    -- step 1: close changed versions, insert brand-new keys
    MERGE INTO silver.dim_person t
    USING tmp_dim_person s
       ON t.src_sys_id = s.src_sys_id AND t.person_type = s.person_type
      AND t.src_person_id = s.src_person_id AND t.is_current
    WHEN MATCHED AND t.row_hash <> s.row_hash THEN
         UPDATE SET is_current = false
    WHEN NOT MATCHED THEN
         INSERT (src_sys_id, person_type, src_person_id, customer_kind, first_name, last_name, full_name,
                 company_name, job_title, birth_date, hire_date, gender, marital_status, email, phone, fax,
                 address_line, postal_code, geography_key, manager_src_id, territory_src_id, support_rep_src_id,
                 row_hash, batch_id)
         VALUES (s.src_sys_id, s.person_type, s.src_person_id, s.customer_kind, s.first_name, s.last_name, s.full_name,
                 s.company_name, s.job_title, s.birth_date, s.hire_date, s.gender, s.marital_status, s.email, s.phone, s.fax,
                 s.address_line, s.postal_code, s.geography_key, s.manager_src_id, s.territory_src_id, s.support_rep_src_id,
                 s.row_hash, p_batch_id);

    -- step 2: new version for keys whose current row was just closed
    INSERT INTO silver.dim_person
           (src_sys_id, person_type, src_person_id, customer_kind, first_name, last_name, full_name,
            company_name, job_title, birth_date, hire_date, gender, marital_status, email, phone, fax,
            address_line, postal_code, geography_key, manager_src_id, territory_src_id, support_rep_src_id,
            row_hash, batch_id)
    SELECT s.src_sys_id, s.person_type, s.src_person_id, s.customer_kind, s.first_name, s.last_name, s.full_name,
           s.company_name, s.job_title, s.birth_date, s.hire_date, s.gender, s.marital_status, s.email, s.phone, s.fax,
           s.address_line, s.postal_code, s.geography_key, s.manager_src_id, s.territory_src_id, s.support_rep_src_id,
           s.row_hash, p_batch_id
    FROM tmp_dim_person s
    WHERE NOT EXISTS (SELECT 1 FROM silver.dim_person t
                      WHERE t.src_sys_id = s.src_sys_id AND t.person_type = s.person_type
                        AND t.src_person_id = s.src_person_id AND t.is_current);
END $$;